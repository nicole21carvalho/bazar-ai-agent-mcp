# Copie para .env (que o Git ignora). Gere cada segredo com: openssl rand -hex 24
AGENTE_SEGREDO=
MCP_SEGREDO=

# Pasta do repositório do Bazar: a senha de admin do Keycloak é lida do .env dele.
BAZAR_DIR=../bazar-microservices-kafka

# Modelo de linguagem. Padrão: Ollama local com qwen3:4b-instruct.
# PROVEDOR=anthropic e MODELO=claude-haiku-5-5 usam o Claude (precisa de ANTHROPIC_CHAVE).
PROVEDOR=ollama
MODELO=qwen3:4b-instruct
ANTHROPIC_CHAVE=

# Volume onde os modelos do Ollama ficam guardados (reaproveite um que já exista).
OLLAMA_VOLUME=bazar_agente_modelos

# Traces (OpenTelemetry). Sem esta linha, vão para o Jaeger do Bazar (http://jaeger:4318).
# Com ela vazia (OTEL_ENDPOINT=), o rastreamento fica desligado.
# OTEL_ENDPOINT=
